name: woodstock-client
version: "@@VERSION@@"
origin: sysutils/woodstock-client
comment: Woodstock Backup Client Agent
desc: <<EOD
Woodstock Backup is a centralized pull-backup solution.
This package provides the client agent (ws_client_daemon) that runs
on machines to be backed up. The central server connects to this
agent via mTLS to retrieve data.
EOD
maintainer: ulrich.vdh@gmail.com
www: https://woodstock.shadoware.org/
arch: @@ABI@@
prefix: /usr/local
licenselogic: single
licenses: [MIT]

deps: {}

options: {}

directories: {
  /var/db/woodstock: "y"
  /var/log/woodstock: "y"
}
