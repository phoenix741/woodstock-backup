{
  "name": "@woodstock/server",
  "version": "2.0.0-alpha.50",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:api": "nest build -- api",
    "build:clientApi": "nest build -- clientApi",
    "build:schedule": "nest build -- scheduleWorker",
    "build:backup": "nest build -- backupWorker",
    "buildall": "concurrently --timings -n w: npm:build:*",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:api": "nest start -- api",
    "start:clientApi": "nest start -- clientApi",
    "start:schedule": "nest start -- scheduleWorker",
    "startall": "concurrently -n w: 'npm:start:*(!dev|prod|debug)'",
    "start:dev": "nest start --watch",
    "start:dev:api": "nest start --watch -- api",
    "start:dev:clientApi": "nest start --watch -- clientApi",
    "start:dev:schedule": "nest start --watch -- scheduleWorker",
    "startdevall": "concurrently -n w: 'npm:start:dev:*'",
    "start:debug": "nest start --debug --watch",
    "start:prod": "concurrently -n w: 'npm:start:prod:*'",
    "start:prod:api": "node dist/apps/api/main",
    "start:prod:clientApi": "node dist/apps/clientApi/main",
    "start:prod:schedule": "node dist/apps/scheduleWorker/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@isaacs/ttlcache": "^1.4.1",
    "@keyv/redis": "^4.6.0",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.5",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.0",
    "@woodstock/shared-rs": "*",
    "archiver": "^7.0.1",
    "bullmq": "^5.56.4",
    "cache-manager": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron-parser": "^5.3.0",
    "express": "^5",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "logform": "^2.7.0",
    "node-forge": "^1.3.1",
    "passport": "^0.7.0",
    "passport-client-cert": "^2.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "shelljs": "^0.10.0",
    "source-map-support": "^0.5.21",
    "swagger-ui-express": "^5.0.1",
    "tmp": "^0.2.3",
    "webpack": "^5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.5",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.15",
    "@types/node-forge": "^1.3.13",
    "@types/shelljs": "^0.8.17",
    "@types/tmp": "^0.2.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "jest": "^30.0.4",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^@woodstock/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "(.+)\\.js": "$1"
    }
  }
}
