# Woodstock Backup Server - Environment Configuration
# Edit this file to configure the server before starting services.

# Path to backup data directory (FreeBSD convention)
BACKUP_PATH=/var/db/woodstock

# Redis/Valkey connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Path to the pre-compiled frontend static files
STATIC_PATH=/usr/local/share/woodstock/static

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# API server listen address (default: all interfaces)
MANAGEMENT_API_LISTEN=0.0.0.0

# API server port (default: 3000)
MANAGEMENT_API_PORT=3000

# Job worker concurrency settings
BACKUP_CONCURRENCY=2
RESTORE_CONCURRENCY=8
MAINTENANCE_CONCURRENCY=2
